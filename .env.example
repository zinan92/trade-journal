# Optional: AI provider selection (auto | api | agy | gemini-cli)
# - auto (default): uses GOOGLE_API_KEY/GEMINI_API_KEY if set, otherwise Antigravity CLI (`agy`), otherwise Gemini CLI (`gemini`)
# GEMINI_PROVIDER=auto

# Optional: Gemini API Key (for direct HTTP API mode; not required when using `agy` CLI)
# Core charts, 3-step pre-trading plan, article journal, and calendar packages work 100% without any AI provider.
GOOGLE_API_KEY=

# Optional: Tiered Gemini API models (fast for dictation organize, pro + thinking for Volatility Coach & Behavior Audit)
# GEMINI_FAST_MODEL=gemini-3.8-flash
# GEMINI_PRO_MODEL=gemini-4-neon
# GEMINI_PRO_THINKING=high

# Optional: Explicit models when using Antigravity CLI (`agy`) or Gemini CLI (`gemini`)
# AGY_FAST_MODEL=
# AGY_PRO_MODEL=
# GEMINI_CLI_FAST_MODEL=gemini-3.5-flash
# GEMINI_CLI_PRO_MODEL=gemini-2.5-pro

# Optional: Custom local SQLite & screenshot storage directory (defaults to ~/.trade-journal)
# TRADE_JOURNAL_DATA=~/.trade-journal

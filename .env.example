# Optional: Gemini API Key (only required for AI dictation auto-organize, behavior review & Volatility Coach)
# Core charts, 3-step pre-trading plan, article journal, and calendar packages work 100% without any API key.
GOOGLE_API_KEY=

# Optional: Tiered Gemini models (fast for dictation organize, pro + thinking for Volatility Coach & Behavior Audit)
# GEMINI_FAST_MODEL=gemini-3.8-flash
# GEMINI_PRO_MODEL=gemini-4-neon
# GEMINI_PRO_THINKING=high

# Optional: Custom local SQLite & screenshot storage directory (defaults to ~/.trade-journal)
# TRADE_JOURNAL_DATA=~/.trade-journal
